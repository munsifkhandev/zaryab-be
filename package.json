{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "argon2@0.45.2": true,
    "msgpackr-extract": false,
    "@scarf/scarf": false
  },
  "scripts": {
    "build": "nest build",
    "prebuild": "prisma generate",
    "preverify": "prisma generate",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run test:foundation && npm run test:auth && npm run test:catalog && npm run test:commerce && npm run test:extended && npm run lint && npm run build && npm run db:check",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:check": "node --env-file-if-exists=.env scripts/check-database.mjs",
    "db:inspect": "node scripts/inspect-database.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "auth:create-admin": "node scripts/create-admin.mjs",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:foundation": "vitest run --config ./vitest.config.e2e.ts test/foundation.e2e-spec.ts",
    "test:auth": "vitest run --config ./vitest.config.e2e.ts test/auth.e2e-spec.ts",
    "test:catalog": "vitest run --config ./vitest.config.e2e.ts test/catalog.e2e-spec.ts",
    "test:commerce": "vitest run --config ./vitest.config.e2e.ts test/commerce.e2e-spec.ts",
    "test:extended": "vitest run --config ./vitest.config.e2e.ts test/extended.e2e-spec.ts",
    "test:integration": "vitest run --config ./vitest.config.integration.ts"
  },
  "overrides": {
    "@nestjs/mau": {
      "inquirer": "8.2.7",
      "undici": "6.29.1"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
