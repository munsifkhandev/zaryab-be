NODE_ENV=development
PORT=4000
# Local development only. NestJS runs on the host, not inside Compose.
DATABASE_URL="postgresql://zaryab:zaryab@localhost:5434/zaryab_ecommerce?schema=public"
# Optional: create and migrate this SEPARATE database before test:integration.
# TEST_DATABASE_URL="postgresql://zaryab:zaryab@localhost:5434/zaryab_ecommerce_test?schema=public"
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_MAX=120
RATE_LIMIT_TTL_MS=60000
SESSION_TTL_SECONDS=86400
COD_ENABLED=true

# Optional integrations stay disabled until real accounts/services are configured.
EMAIL_PROVIDER=disabled
ASYNC_JOBS_ENABLED=false
STORAGE_PROVIDER=disabled
# REDIS_URL=redis://localhost:6380/0
# RESEND_API_KEY=
# EMAIL_FROM=shop@example.com
# EMAIL_ENCRYPTION_KEY=64_hex_characters_generated_locally
# STOREFRONT_URL=http://localhost:3000
# S3_REGION=us-east-1
# S3_BUCKET=zaryab-media
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# MEDIA_PUBLIC_URL=http://localhost:9000/zaryab-media
# Expiry polling; defaults to false in test mode. Enable on at least one live API instance.
COMMERCE_MAINTENANCE_ENABLED=true
# Optional: configure BOTH values to enable Observe. Never commit real keys.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
